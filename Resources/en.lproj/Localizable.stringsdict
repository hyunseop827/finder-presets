			<string>%lld folder</string>
			<key>other</key>
			<string>%lld folders</string>
		</dict>
	</dict>
	<key>이 프리셋을 지정한 폴더 %lld개는
"선택한 프리셋 사용"이 됩니다.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@folders@</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>The folder assigned to it goes back to "Selected preset".</string>
			<key>other</key>
			<string>The %lld folders assigned to it go back to "Selected preset".</string>
		</dict>
	</dict>
	<key>프리셋 %lld개를 불러왔습니다: %@</key>
