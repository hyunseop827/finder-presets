			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Icons in the folder whose icon size or spacing changes are placed anew so they do not overlap.</string>
			<key>other</key>
			<string>Icons in %lld folders whose icon size or spacing changes are placed anew so they do not overlap.</string>
		</dict>
	</dict>
	<key>%lld개 폴더를 바꿉니다.</key>
