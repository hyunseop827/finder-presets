<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ %lld개 폴더</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%@: %#@folders@</string>
